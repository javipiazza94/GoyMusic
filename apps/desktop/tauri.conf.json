{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GoyMusic",
  "version": "0.1.0",
  "identifier": "dev.goymusic.desktop",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../../ui/dist",
    "beforeDevCommand": "pnpm --dir ui dev",
    "beforeBuildCommand": "pnpm --dir ui build"
  },
  "app": {
    "windows": [
      {
        "title": "GoyMusic",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "dragDropEnabled": false,
        "label": "main"
      },
      {
        "label": "mini",
        "title": "GoyMusic · mini",
        "url": "index.html?ventana=mini",
        "width": 380,
        "height": 128,
        "resizable": false,
        "decorations": false,
        "visible": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' art: http://art.localhost data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"]
  }
}
